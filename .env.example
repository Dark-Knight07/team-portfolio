# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.

NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Example server-side secret (leave empty in git, set real value in Vercel / GitHub Secrets):
# SOME_API_KEY=

# --- Contact / inquiry forms (server-only; never prefix with NEXT_PUBLIC_) ---
# Configure at least one delivery method in production, or form submissions return 503.
# Option A: webhook (Slack incoming webhook, Discord, Make, Zapier...)
# INQUIRY_WEBHOOK_URL=
# Option B: email through Resend (https://resend.com)
#   Testing: INQUIRY_FROM_EMAIL=onboarding@resend.dev works, but Resend only delivers to the email you signed up with.
#   Live: verify your own domain in Resend, then use an address on it, e.g. INQUIRY_FROM_EMAIL="TetraNex <inquiries@your-domain>".
# RESEND_API_KEY=
# INQUIRY_TO_EMAIL=
# INQUIRY_FROM_EMAIL=
# In local development with neither set, submissions are written to .data/inquiries.jsonl

# --- Analytics & search (public values, safe to expose; set in Vercel > Environment Variables) ---
# Google Analytics 4 measurement ID, looks like G-XXXXXXXXXX. Analytics (and the cookie banner) stay OFF until this is set.
# NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (just the content value of the meta tag).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
